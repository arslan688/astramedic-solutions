# Enable Rewrite Engine

RewriteEngine On

# Prevent directory browsing (blocks users from viewing /css/, /php/, /scripts/, /images/)

Options -Indexes

# Protect sensitive files (.htaccess and config files)

<FilesMatch "^(\.htaccess|contact-form-config\.php)$">
Require all denied
</FilesMatch>

# Redirect external .php requests to clean URLs (301 Permanent Redirect for SEO)

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Internally map clean URLs to .php files

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [NC,L]

# Custom 404 Error Page

ErrorDocument 404 /404.php
